{
  "permissions": {
    "allow": [
      "Bash(node /home/user/gdrive_tool/upload.mjs *)",
      "Bash(npm install --prefix /home/user/gdrive_tool)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm install --prefix /home/user/gdrive_tool --silent 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
